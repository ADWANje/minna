# ── Supabase (Project Settings → API) ──────────────────────────────
# Project URL
SUPABASE_URL=https://xxxxxxxx.supabase.co
# The SECRET / service_role key. Server-only. Never expose it in the browser.
SUPABASE_SERVICE_ROLE_KEY=

# ── Admin ──────────────────────────────────────────────────────────
# Password for /admin (use a long one)
ADMIN_PASSWORD=
# Random string, 32+ characters, used to sign the admin session cookie
SESSION_SECRET=
# Random string used to hash visitor IPs for rate limiting (raw IPs are never stored)
IP_HASH_SALT=

# ── Site ───────────────────────────────────────────────────────────
# Full public URL, no trailing slash
NEXT_PUBLIC_SITE_URL=https://minna.jbal.ps
# Leave empty on a subdomain. Use e.g. /minna to serve under a path.
NEXT_PUBLIC_BASE_PATH=
# Email shown on the about/privacy page for questions and removal help
NEXT_PUBLIC_CONTACT_EMAIL=
# Hide the public counter until this many pages are published
NEXT_PUBLIC_COUNTER_MIN=50
